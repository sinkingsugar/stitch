{
  "manifest_version": 3,
  "name": "Stitch",
  "version": "0.1.0",
  "description": "Lets your Stitch agents work in tabs of their own in this Chrome profile, beside you: Stop, Take over and Hand back on every agent tab.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["debugger", "tabs", "tabGroups", "nativeMessaging", "storage", "idle", "contextMenus", "downloads", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js" },
  "action": { "default_title": "Stitch", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true }
  ]
}
