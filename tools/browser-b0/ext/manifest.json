{
  "manifest_version": 3,
  "name": "Stitch B0 spike",
  "version": "0.0.2",
  "description": "B0 spike: chrome.debugger relayed over native messaging.",
  "key": "",
  "permissions": ["debugger", "tabs", "tabGroups", "nativeMessaging", "storage", "idle", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start" }
  ]
}
